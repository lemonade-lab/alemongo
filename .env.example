# ============================================================================
# Alemongo 环境变量配置示例
# ============================================================================
# Alemongo 完全基于环境变量进行配置，无需配置文件即可运行
# 
# 使用方法: 
#   1. 零配置: 直接运行程序，使用所有默认值
#   2. 环境变量: 复制此文件为 .env，根据需求修改配置值
#   3. 系统启动: 自动读取环境变量，未设置的项使用默认值
# 
# 所有配置项都是可选的，只需配置需要修改的部分
# ============================================================================

# ----------------------------------------------------------------------------
# 基础配置 (Application Configuration)
# ----------------------------------------------------------------------------
# ALEMONGO_NAME: 应用名称，用于日志输出和系统标识
# 默认值: alemongo
ALEMONGO_NAME=alemongo

# ALEMONGO_MODE: 运行模式，影响日志输出和性能优化
# 可选值: debug, release, test
# 默认值: release
# - debug: 开发模式，输出详细日志，不启用性能优化
# - release: 生产模式，优化性能，精简日志
# - test: 测试模式，用于单元测试
ALEMONGO_MODE=release

# ----------------------------------------------------------------------------
# 服务器配置 (Server Configuration)
# ----------------------------------------------------------------------------
# ALEMONGO_SERVER_HOST: HTTP 服务监听地址
# 默认值: 127.0.0.1 (仅本地访问)
# 建议:
#   - 开发环境: 127.0.0.1 或 localhost
#   - 生产环境: 0.0.0.0 (允许外部访问) 或具体IP
ALEMONGO_SERVER_HOST=127.0.0.1

# ALEMONGO_SERVER_PORT: HTTP 服务监听端口
# 默认值: 17187
# 注意: 确保端口未被其他程序占用
ALEMONGO_SERVER_PORT=17187

# ----------------------------------------------------------------------------
# Token 认证配置 (Token Configuration)
# ----------------------------------------------------------------------------
# ALEMONGO_TOKEN_KEY: JWT Token 签名密钥，用于用户身份认证
# 默认值: alemongo
# 安全建议: 
#   - 生产环境务必修改为随机强密码 (建议32位以上)
#   - 可使用: openssl rand -base64 32 生成随机密钥
#   - 密钥泄露将导致安全风险，请妥善保管
ALEMONGO_TOKEN_KEY=alemongo

# ALEMONGO_TOKEN_EXPIRES_TIME: Token 过期时间（小时）
# 默认值: 24 (小时)
# 说明: 用户登录后 Token 的有效期，过期后需要重新登录
# 建议:
#   - 开发环境: 24-168 小时 (1-7天)
#   - 生产环境: 2-24 小时，根据安全需求调整
ALEMONGO_TOKEN_EXPIRES_TIME=24

# ----------------------------------------------------------------------------
# 日志配置 (Logging Configuration)
# ----------------------------------------------------------------------------
# ALEMONGO_LOG_LEVEL: 日志输出级别
# 可选值: debug, info, warn, error, fatal
# 默认值: info
# 说明:
#   - debug: 调试信息，包含所有日志
#   - info: 一般信息，包含重要操作日志
#   - warn: 警告信息，可能存在的问题
#   - error: 错误信息，程序错误但可继续运行
#   - fatal: 致命错误，程序无法继续运行
# 建议: 生产环境使用 info 或 warn
ALEMONGO_LOG_LEVEL=info

# ALEMONGO_LOG_FILENAME: 日志文件存储目录
# 默认值: work/logs
# 说明: 系统日志、机器人日志等所有日志文件的根目录
# 注意: 确保目录具有写入权限，系统会自动创建目录
ALEMONGO_LOG_FILENAME=work/logs

# ----------------------------------------------------------------------------
# SMTP 邮件服务配置 (Email Configuration)
# ----------------------------------------------------------------------------
# 说明: 用于发送系统通知邮件（密码重置、异常告警等）
# 如不需要邮件功能，可留空不配置

# ALEMONGO_SMTP_PROVIDER: 邮件服务提供商标识
# 默认值: qq
# 常见提供商: qq, gmail, outlook, 163, aliyun
# 说明: 仅用于标识，实际连接参数由后续配置决定
ALEMONGO_SMTP_PROVIDER=qq

# ALEMONGO_SMTP_HOST: SMTP 服务器地址
# 默认值: smtp.qq.com
# 常见配置:
#   - QQ邮箱: smtp.qq.com
#   - Gmail: smtp.gmail.com
#   - 163邮箱: smtp.163.com
#   - 阿里云: smtp.aliyun.com
ALEMONGO_SMTP_HOST=smtp.qq.com

# ALEMONGO_SMTP_PORT: SMTP 服务器端口
# 默认值: 587
# 常见端口:
#   - 25: 标准SMTP端口（部分ISP封禁）
#   - 465: SMTP over SSL/TLS
#   - 587: STARTTLS（推荐）
ALEMONGO_SMTP_PORT=587

# ALEMONGO_SMTP_USERNAME: SMTP 登录用户名（通常是完整邮箱地址）
# 示例: your_email@qq.com
ALEMONGO_SMTP_USERNAME=

# ALEMONGO_SMTP_PASSWORD: SMTP 登录密码或授权码
# 注意: 
#   - QQ邮箱/163邮箱等需要使用"授权码"而非登录密码
#   - 授权码获取: 邮箱设置 -> 账户 -> 开启SMTP服务 -> 生成授权码
# 安全提醒: 授权码具有邮箱完整权限，请勿泄露
ALEMONGO_SMTP_PASSWORD=

# ALEMONGO_SMTP_FROM_EMAIL: 发件人邮箱地址
# 说明: 接收方看到的发件人地址，通常与 SMTP_USERNAME 相同
# 示例: your_email@qq.com
ALEMONGO_SMTP_FROM_EMAIL=

# ----------------------------------------------------------------------------
# GitHub OAuth 配置 (GitHub OAuth Configuration)
# ----------------------------------------------------------------------------
# 说明: 启用 GitHub 快捷登录功能（可选）
# 如不需要 GitHub 登录，可留空不配置
# 配置教程: 查看 READMES/README_GITHUB_OAUTH.md

# ALEMONGO_GITHUB_CLIENT_ID: GitHub OAuth 应用客户端ID
# 获取方式: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
ALEMONGO_GITHUB_CLIENT_ID=

# ALEMONGO_GITHUB_CLIENT_SECRET: GitHub OAuth 应用客户端密钥
# 安全提醒: Client Secret 具有应用完整权限，请妥善保管
ALEMONGO_GITHUB_CLIENT_SECRET=

# ALEMONGO_GITHUB_REDIRECT_URL: OAuth 回调地址
# 注意: 
#   - 必须与 GitHub OAuth App 中配置的回调URL完全一致
#   - 生产环境需要改为实际域名，如: https://yourdomain.com/login
ALEMONGO_GITHUB_REDIRECT_URL=http://localhost:17187/login

# ----------------------------------------------------------------------------
# 数据库配置 (Database Configuration)
# ----------------------------------------------------------------------------
# 说明: Alemongo 支持多种数据库类型，默认使用 SQLite（零配置）

# ALEMONGO_DB_DRIVER: 数据库驱动类型
# 默认值: sqlite
# 支持的驱动:
#   - sqlite: 轻量级文件数据库，适合中小型部署（推荐）
#   - mysql: MySQL/MariaDB，适合大型部署
#   - postgres: PostgreSQL，高性能关系型数据库
# 说明: SQLite 无需额外安装，其他数据库需要独立部署
ALEMONGO_DB_DRIVER=sqlite

# ALEMONGO_DB_SQLITE_PATH: SQLite 数据库文件路径
ALEMONGO_DB_SQLITE_PATH=work/data/alemongo.db

# ALEMONGO_DB_DSN: MySQL/PostgreSQL 数据库连接字符串（DSN）
# 说明: 仅当 DB_DRIVER 为 mysql 或 postgres 时需要配置
# 格式示例:
#   MySQL:
#     user:password@tcp(localhost:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local
#   PostgreSQL:
#     host=localhost user=postgres password=secret dbname=alemongo port=5432 sslmode=disable
# ALEMONGO_DB_DSN=user:password@tcp(localhost:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local

# ALEMONGO_DB_AUTO_MIGRATE: 启动时自动执行数据库迁移
# 说明:
#   - true: 启动时自动创建/更新数据库表结构（推荐）
#   - false: 不自动迁移，需要手动管理数据库结构
ALEMONGO_DB_AUTO_MIGRATE=true